# ==============================================================================
# GSTAutoPilot Web — Local Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API & TENANT CONFIGURATION
# ------------------------------------------------------------------------------
# Backend API URL (Vite dev server proxies /api and /uploads to this)
VITE_API_BASE_URL=https://gstbackend-3tmw.onrender.com

# Active Tenant GUID (sent automatically in the X-Tenant-Id header for multi-tenancy)
VITE_DEFAULT_TENANT_ID=33333333-3333-3333-3333-333333333333

# Active Runtime Mode: 'development' | 'production'
VITE_APP_ENV=development

# Support contact destination for error alerts and diagnostic reports
VITE_SUPPORT_EMAIL=support@carolsolutions.com


# ==============================================================================
# 2. WHITEBOOKS IRP & GSP INTEGRATION (HOW IT WORKS & WHERE TO PASTE)
# ==============================================================================
# WhiteBooks is the government-authorized GST Suvidha Provider (GSP) & Invoice 
# Registration Portal (IRP) used by GSTAutoPilot for:
#   1. E-Invoicing (IRN Generation, QR Code generation, and 24h IRN Cancellation)
#   2. E-Way Bill Generation & Real-time Vehicle updates
#   3. Auto-syncing live GSTR-2B inward statements from GSTN Portal
#   4. 1-Click Return Filing & OTP authentication for GSTR-1 & GSTR-3B
#
# HOW IT WORKS:
#   - Option A (Recommended): Configure via the Web UI at Settings -> WhiteBooks API.
#     The UI saves credentials securely per-tenant in the database.
#   - Option B (Environment Default): Paste your credentials below to pre-populate
#     or override defaults for this deployment.
# ------------------------------------------------------------------------------

# WhiteBooks Mode: 'sandbox' (testing with dummy GSTINs) or 'production' (live tax filings)
VITE_WHITEBOOKS_DEFAULT_ENV=sandbox

# WhiteBooks Base URL:
#   - Sandbox: https://sandbox.whitebooks.in
#   - Production: https://api.whitebooks.in
VITE_WHITEBOOKS_BASE_URL=https://sandbox.whitebooks.in

# Paste your WhiteBooks API Client Key here:
# (Obtain from: WhiteBooks Portal -> Settings -> API Keys)
VITE_WHITEBOOKS_API_KEY=wb_sandbox_demo_key_paste_here

# Paste your WhiteBooks API Secret here:
VITE_WHITEBOOKS_API_SECRET=wb_sandbox_demo_secret_paste_here

# GST Portal GSP Username (Registered GSP username on gst.gov.in / einvoice1.gst.gov.in)
VITE_WHITEBOOKS_GSP_USERNAME=GSTN_GSP_USER_DEMO

# GST Portal GSP Password
VITE_WHITEBOOKS_GSP_PASSWORD=GSTN_GSP_PASS_DEMO
